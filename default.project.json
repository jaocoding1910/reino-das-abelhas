			"Shared": {
				"$path": "src/shared"
			},
			"Assets": {
				"$path": "assets"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CameraMode": "LockFirstPerson",
				"CharacterWalkSpeed": 16,
				"CharacterUseJumpPower": false,
