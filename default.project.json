				"EnvironmentSpecularScale": 1
			}
		},
		"TextChatService": {
			"ChatWindowConfiguration": {
				"$className": "ChatWindowConfiguration",
				"$properties": {
					"HorizontalAlignment": "Right",
					"VerticalAlignment": "Bottom"
				}
			}
		},
		"ReplicatedFirst": {
			"Abertura": {
